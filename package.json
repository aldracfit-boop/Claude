{
  "name": "tour-de-force",
  "version": "0.1.0",
  "description": "Tour de Force — tower defense coopératif en temps réel (fusion, boss, coop 1-4 joueurs)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "simulate": "node tools/simulate.js",
    "lint": "npx --yes eslint@9 client shared server tools test",
    "format": "npx --yes prettier@3 --write \"client/**/*.{js,css,html}\" \"shared/**/*.js\" \"server/**/*.js\" \"tools/**/*.js\" \"test/**/*.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
